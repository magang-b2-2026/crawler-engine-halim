# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Salin file ini menjadi .env dan isi nilai yang sesuai pada mesin lokal Anda.
# CATATAN: File .env yang asli TIDAK BOLEH di-commit ke Git / repository publik.
# ==============================================================================

# 1. Autentikasi Binary AITF Engine (Opsional jika menggunakan Scrapper Python)
# Token lisensi untuk binary ./aitf-engine (Windows / Linux / MacOS)
CRAWLER_ENGINE_TOKEN=your_token_here

# 2. Pengaturan Proxy (Opsional untuk scraping volume besar / anti-rate-limit)
# Format: http://user:password@proxy_host:port atau socks5://proxy_host:port
# HTTP_PROXY=
# HTTPS_PROXY=

# 3. Pengaturan Pipeline Scrapper Python (Opsional default override)
# PIPELINE_CONCURRENCY=8
# PIPELINE_SIM_THRESHOLD=0.80
# PIPELINE_MIN_WORDS=25
